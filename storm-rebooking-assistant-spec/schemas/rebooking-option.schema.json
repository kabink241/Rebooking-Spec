{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RebookingOption",
  "description": "One complete plan for the whole party, as suggested by the assistant. Fare outcomes are per group because a not-covered split party is priced per member and flight (SPEC 9.4).",
  "type": "object",
  "required": [
    "option_id",
    "kind",
    "groups",
    "arrival_gap_minutes",
    "risk_flags",
    "requires"
  ],
  "properties": {
    "option_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "TOGETHER_SAME_FLIGHT",
        "SAME_FLIGHT_NOT_ADJACENT",
        "SAME_FLIGHT_AFTER_SEAT_MOVE",
        "TOGETHER_LATER",
        "SPLIT_ACROSS_FLIGHTS"
      ]
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "passenger_ids",
          "flights",
          "seats_adjacent",
          "arrival_time",
          "fare_outcome"
        ],
        "properties": {
          "passenger_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "flights": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "departure_datetime": {
            "type": "string",
            "format": "date-time"
          },
          "flight_status": {
            "enum": [
              "scheduled",
              "delayed"
            ]
          },
          "seats_adjacent": {
            "type": "boolean"
          },
          "arrival_time": {
            "type": "string",
            "format": "date-time"
          },
          "connection_slack_minutes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "contains_minor": {
            "type": "boolean",
            "description": "Derived from members."
          },
          "contains_adult": {
            "type": "boolean"
          },
          "fare_outcome": {
            "$ref": "#/$defs/fareOutcome"
          },
          "documentation_line": {
            "type": [
              "string",
              "null"
            ],
            "description": "STORM WAIVER DEN NOV26 <original confirmation number> for covered bookings; null for not-covered (clauses 3.6, 4.4)."
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "passenger_id",
                "age_band"
              ],
              "properties": {
                "passenger_id": {
                  "type": "string"
                },
                "age_band": {
                  "enum": [
                    "adult_18_plus",
                    "teen_12_17",
                    "child_5_11",
                    "child_under_5",
                    "lap_infant"
                  ]
                },
                "needs_companion": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "arrival_gap_minutes": {
      "type": "integer",
      "minimum": 0,
      "description": "0 when the party arrives together."
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "enum": [
          "DELAYED",
          "WEATHER_RISK",
          "SEATS_MAY_CHANGE"
        ]
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "enum": [
          "CUSTOMER_CONSENT_SPLIT",
          "LEAD_APPROVAL",
          "SEAT_MOVE_BY_LEAD"
        ]
      }
    },
    "rank_reason": {
      "type": "string"
    }
  },
  "$defs": {
    "fareOutcome": {
      "type": "object",
      "required": [
        "status",
        "clause_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "COVERED_NO_DIFFERENCE",
            "NOT_COVERED_DIFFERENCE",
            "ROUTE_TO_REVENUE_MANAGEMENT",
            "BLOCKED"
          ]
        },
        "fare_paid_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "difference_usd": {
          "type": [
            "number",
            "null"
          ],
          "description": "0 for covered. For not covered: amount collected when the open fare on the new flight is higher, else 0."
        },
        "clause_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Bulletin clauses, for example [\"3.1\", \"3.2\", \"3.3\", \"3.4\"]."
        },
        "blocked_values": {
          "type": [
            "object",
            "null"
          ],
          "description": "When status is BLOCKED: the conflicting waiver_eligible values by source."
        }
      }
    }
  }
}